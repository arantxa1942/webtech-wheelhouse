<% content_for :title, "Create an account" %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-4">
    <h1 class="h3 mb-4">Create an account</h1>

    <%= form_with model: @user, url: registration_path do |f| %>
      <%= render "shared/errors", record: @user %>

      <div class="mb-3">
        <%= f.label :email_address, "Email address", class: "form-label" %>
        <%= f.email_field :email_address, autofocus: true, autocomplete: "username",
              class: field_class(@user, :email_address) %>
        <%= field_error(@user, :email_address) %>
      </div>

      <div class="mb-3">
        <%= f.label :password, "Password", class: "form-label" %>
        <%= f.password_field :password, autocomplete: "new-password", maxlength: 72,
              class: field_class(@user, :password) %>
        <div class="form-text">At least <%= User::MIN_PASSWORD_LENGTH %> characters.</div>
        <%= field_error(@user, :password) %>
      </div>

      <div class="mb-3">
        <%= f.label :password_confirmation, "Confirm password", class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", maxlength: 72,
              class: field_class(@user, :password_confirmation) %>
        <%= field_error(@user, :password_confirmation) %>
      </div>

      <%= f.submit "Create account", class: "btn btn-primary" %>
      <%= link_to "Back to sign in", new_session_path, class: "btn btn-outline-secondary" %>
    <% end %>
  </div>
</div>