<% content_for :title, "Staff" %>

<h1>Staff</h1>
<%= link_to "New staff_member", new_staff_member_path, class: "btn btn-primary mb-3" %>
<% if @staff_members.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Name</th>
        <th>Role</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "staff_member", collection: @staff_members %>
    </tbody>
  </table>
<% else %>
  <p>There are no staff members yet.</p>
<% end %>