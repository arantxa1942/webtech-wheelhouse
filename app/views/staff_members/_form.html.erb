<%= form_with model: staff_member do |f| %>
  <%= render "shared/errors", record: staff_member %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: field_class(staff_member, :name) %>
    <%= field_error(staff_member, :name) %>
  </div>

  <div class="mb-3">
    <%= f.label :role, class: "form-label" %>
    <%= f.text_field :role, class: field_class(staff_member, :role) %>
    <%= field_error(staff_member, :role) %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", staff_member.persisted? ? staff_member_path(staff_member) : staff_members_path, class: "btn btn-outline-secondary" %>
<% end %>