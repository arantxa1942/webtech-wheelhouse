<% content_for :title, @staff_member.name %>

<h1><%= @staff_member.name %></h1>

<dl class="row">
  <dt class="col-sm-3">Role</dt>
  <dd class="col-sm-9"><%= @staff_member.role %></dd>
</dl>

<h2>Repairs handled</h2>

<% if @staff_member.repairs.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Status</th>
        <th>Bike</th>
        <th>Customer</th>
        <th>Promised on</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "repairs/repair", collection: @staff_member.repairs %>
    </tbody>
  </table>
<% else %>
  <p>This staff member has no repairs on file.</p>
<% end %>

<%= link_to "Back to staff", staff_members_path %>