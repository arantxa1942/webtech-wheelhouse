<% content_for :title, "#{@bike.make} #{@bike.model}" %>

<h1><%= @bike.make %> <%= @bike.model %></h1>

<dl class="row">
  <dt class="col-sm-3">Color</dt>
  <dd class="col-sm-9"><%= @bike.color %></dd>

  <dt class="col-sm-3">Serial number</dt>
  <dd class="col-sm-9"><%= @bike.serial_number %></dd>

  <dt class="col-sm-3">Owner</dt>
  <dd class="col-sm-9"><%= link_to @bike.customer.name, customer_path(@bike.customer) %></dd>
</dl>

<h2>Repairs</h2>

<% if @bike.repairs.any? %>
  <table class="table table-striped">
    <thead>
      <tr><th>Photo</th><th>Status</th><th>Bike</th><th>Customer</th><th>Promised on</th></tr>
    </thead>
    <tbody>
      <%= render partial: "repairs/repair", collection: @bike.repairs %>
    </tbody>
  </table>
<% else %>
  <p>This bike has never been in for a repair.</p>
<% end %>

<div class="d-flex gap-2 mt-2">
  <%= link_to "← Back to bikes", bikes_path, class: "btn btn-outline-secondary" %>
  <%= link_to "Edit", edit_bike_path(@bike), class: "btn btn-outline-primary" %>
  <%= button_to "Delete", @bike, method: :delete,
        class: "btn btn-outline-danger",
        form: { data: { turbo_confirm: "Delete bike #{@bike.serial_number}?" } } %>
</div>