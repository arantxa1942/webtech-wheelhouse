<% content_for :title, "Customers" %>

<h1 class="mb-4">Customers</h1>
<%= link_to "New customer", new_customer_path, class: "btn btn-primary mb-3" %>
<% if @customers.any? %>
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>Name</th>
        <th>Phone</th>
        <th>Bikes</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "customer", collection: @customers %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted fst-italic">There are no customers yet.</p>
<% end %>