<%= form_with model: customer do |f| %>
  <%= render "shared/errors", record: customer %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: field_class(customer, :name) %>
    <%= field_error(customer, :name) %>
  </div>

  <div class="mb-3">
    <%= f.label :phone, class: "form-label" %>
    <%= f.text_field :phone, class: field_class(customer, :phone) %>
    <%= field_error(customer, :phone) %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", customer.persisted? ? customer_path(customer) : customers_path, class: "btn btn-outline-secondary" %>
<% end %>