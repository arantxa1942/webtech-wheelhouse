<h1>Services</h1>
<p>Here is our full price list for the most common jobs we do.</p>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Service</th>
      <th>Price</th>
    </tr>
  </thead>

  <tbody>
    <% @services.each do |service| %>
      <tr>
        <td><%= service.name %></td>
        <td><%= number_to_currency(service.price, unit: "$", separator: ",", delimiter: ".", precision: 0) %></td>
      </tr>
    <% end %>
  </tbody>
</table>