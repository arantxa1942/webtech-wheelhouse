<%= form_with model: service do |f| %>
  <%= render "shared/errors", record: service %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: field_class(service, :name) %>
    <%= field_error(service, :name) %>
  </div>

  <div class="mb-3">
    <%= f.label :price, class: "form-label" %>
    <%= f.number_field :price, step: "0.01", min: 0, class: field_class(service, :price) %>
    <%= field_error(service, :price) %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", service.persisted? ? service_path(service) : services_path, class: "btn btn-outline-secondary" %>
<% end %>