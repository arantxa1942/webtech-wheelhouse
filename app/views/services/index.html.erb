<% content_for :title, "Services" %>

<h1>Services</h1>
<%= link_to "New service", new_service_path, class: "btn btn-primary mb-3" %>
<% if @services.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Service</th>
        <th>Price</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "service", collection: @services %>
    </tbody>
  </table>
<% else %>
  <p>There are no services yet.</p>
<% end %>