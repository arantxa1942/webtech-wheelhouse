<% content_for :title, "Repairs" %>

<h1>Repairs</h1>

<% if @repairs.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Status</th>
        <th>Bike</th>
        <th>Customer</th>
        <th>Promised on</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "repair", collection: @repairs %>
    </tbody>
  </table>
<% else %>
  <p>There are no repairs yet.</p>
<% end %>