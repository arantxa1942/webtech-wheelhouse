<% overdue = repair.promised_on.present? && repair.promised_on.past? && repair.returned_at.nil? %>

<tr class="<%= "table-danger" if overdue %>">
  <td><%= link_to repair.status.titleize, repair_path(repair) %></td>
  <td><%= link_to repair.bike.make, bike_path(repair.bike) %></td>
  <td><%= link_to repair.bike.customer.name, customer_path(repair.bike.customer) %></td>
  <td>
    <%= repair.promised_on ? l(repair.promised_on, format: :long) : "not scheduled" %>
    <% if overdue %>
      <span class="badge bg-danger">Overdue</span>
    <% end %>
  </td>
</tr>