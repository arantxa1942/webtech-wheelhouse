<% content_for :title, "Repair ##{@repair.id}" %>

<h1>Repair #<%= @repair.id %></h1>

<dl class="row">
  <dt class="col-sm-3">Status</dt>
  <dd class="col-sm-9"><%= @repair.status.titleize %></dd>

  <dt class="col-sm-3">Bike</dt>
  <dd class="col-sm-9"><%= link_to @repair.bike.make, bike_path(@repair.bike) %></dd>

  <dt class="col-sm-3">Customer</dt>
  <dd class="col-sm-9"><%= link_to @repair.bike.customer.name, customer_path(@repair.bike.customer) %></dd>

  <dt class="col-sm-3">Received</dt>
  <dd class="col-sm-9"><%= l(@repair.received_at, format: :long) %></dd>

  <dt class="col-sm-3">Promised on</dt>
  <dd class="col-sm-9"><%= @repair.promised_on ? l(@repair.promised_on, format: :long) : "Not scheduled" %></dd>

  <dt class="col-sm-3">Returned</dt>
  <dd class="col-sm-9"><%= @repair.returned_at ? l(@repair.returned_at, format: :long) : "Not returned yet" %></dd>
</dl>

<h2>Services charged</h2>

<% if @repair.repair_services.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Service</th>
        <th>Price charged</th>
      </tr>
    </thead>
    <tbody>
      <% @repair.repair_services.each do |line| %>
        <tr>
          <td><%= link_to line.service.name, service_path(line.service) %></td>
          <td><%= number_to_currency(line.charged_price) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <th>Total</th>
        <th><%= number_to_currency(@repair.repair_services.sum(:charged_price)) %></th>
      </tr>
    </tfoot>
  </table>
<% else %>
  <p>No services have been charged on this repair yet.</p>
<% end %>

<%= link_to "Back to repairs", repairs_path %>